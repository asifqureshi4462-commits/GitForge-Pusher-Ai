<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.GitForge.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/gf_button_height</item>
        <item name="cornerRadius">@dimen/gf_radius_button</item>
    </style>

    <style name="Widget.GitForge.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="cardCornerRadius">@dimen/gf_radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">@dimen/gf_stroke_hairline</item>
    </style>

    <style name="Widget.GitForge.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">?attr/colorSurfaceContainer</item>
        <item name="itemIconTint">@color/gf_nav_item_tint</item>
        <item name="itemTextColor">@color/gf_nav_item_tint</item>
    </style>

    <style name="Widget.GitForge.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/gf_radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/gf_radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/gf_radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/gf_radius_input</item>
    </style>
</resources>
